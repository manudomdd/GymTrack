<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_purple"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bienvenido, Coach" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/magenta"/>
        <Space android:layout_width="wrap_content" android:layout_height="24dp"/>

        <!-- Fila 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" app:cardBackgroundColor="@color/input_field_bg" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="32sp"/>
                    <Space android:layout_width="wrap_content" android:layout_height="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clientes Totales" android:textSize="14sp" android:textColor="@color/white_54"/>
                    <TextView android:id="@+id/tv_clientes_totales" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space android:layout_width="16dp" android:layout_height="match_parent"/>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" app:cardBackgroundColor="@color/input_field_bg" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="32sp"/>
                    <Space android:layout_width="wrap_content" android:layout_height="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activos Hoy" android:textSize="14sp" android:textColor="@color/white_54"/>
                    <TextView android:id="@+id/tv_activos_hoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <Space android:layout_width="wrap_content" android:layout_height="16dp"/>

        <!-- Fila 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" app:cardBackgroundColor="@color/input_field_bg" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏋" android:textSize="32sp"/>
                    <Space android:layout_width="wrap_content" android:layout_height="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrenamientos" android:textSize="14sp" android:textColor="@color/white_54"/>
                    <TextView android:id="@+id/tv_entrenamientos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space android:layout_width="16dp" android:layout_height="match_parent"/>
            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" app:cardBackgroundColor="@color/input_field_bg" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📅" android:textSize="32sp"/>
                    <Space android:layout_width="wrap_content" android:layout_height="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Esta Semana" android:textSize="14sp" android:textColor="@color/white_54"/>
                    <TextView android:id="@+id/tv_esta_semana" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
